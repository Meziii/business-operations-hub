# Copier en .env puis adapter. Ne jamais committer le fichier .env.

# Base de données (conteneur db de docker-compose)
POSTGRES_USER=boh
POSTGRES_PASSWORD=boh
POSTGRES_DB=boh
# Depuis le poste : port 5434. Dans docker-compose, l'API utilise db:5432.
DATABASE_URL=postgresql+psycopg://boh:boh@localhost:5434/boh

# Sécurité : générer une valeur longue et aléatoire hors développement
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-any-deployment
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
APP_ENV=development

# Comptes de démonstration (données synthétiques). 12 caractères minimum.
DEMO_PASSWORD=Demo-hub-2026
# Habillage sectoriel de la démo : generic, automotive, industrial (app/demo_profiles.py)
DEMO_PROFILE=generic

# IA : "mock" fonctionne sans clé. "claude" nécessite ANTHROPIC_API_KEY (phase 2).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
